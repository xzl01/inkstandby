<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="墨屏待机"
            android:textColor="#000000"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="v1.1.0 · 彩色墨水屏待机壁纸"
            android:textColor="#666666"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="还没更新过"
            android:textColor="#000000"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="预览（最近一次应用）"
            android:textColor="#333333"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="6dp"
            android:background="#EEEEEE"
            android:contentDescription="待机图预览"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="内容来源"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="本地图片文件" />

            <RadioButton
                android:id="@+id/rbUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="网络图片 URL" />

            <RadioButton
                android:id="@+id/rbText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="文字模板（按 e-ink 风格渲染）" />

            <RadioButton
                android:id="@+id/rbQuotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="语录列表（每次随机选一条）" />

            <RadioButton
                android:id="@+id/rbInkQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="引据 InkQuote（带出处的每日一句）" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/inkquoteBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/inkquoteUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="InkQuote 服务地址，如 http://192.168.100.168:8765"
                android:inputType="textUri"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="分类"
                android:textColor="#333333"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/inkquoteCategoryGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbInkAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="全部" />

                <RadioButton
                    android:id="@+id/rbInkBook"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="书本" />

                <RadioButton
                    android:id="@+id/rbInkInternet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="互联网" />

                <RadioButton
                    android:id="@+id/rbInkAnime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="动漫" />

                <RadioButton
                    android:id="@+id/rbInkMovie"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="电影" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/cbInkVerified"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="仅使用已核对出处的条目" />

            <CheckBox
                android:id="@+id/cbInkDaily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="每日一句（关闭则每次亮屏随机）" />

            <Button
                android:id="@+id/testInkQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="测试连接并预览" />

            <TextView
                android:id="@+id/inkquoteCacheInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="离线缓存：还没有（联网后自动缓存）"
                android:textColor="#333333"
                android:textSize="13sp" />

            <Button
                android:id="@+id/refreshInkQuoteCache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="刷新本地缓存（整批下载）" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="连不上时自动使用上一次缓存；再失败则用内置的 21 条离线数据。"
                android:textColor="#555555"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/filePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="本地图片绝对路径，如 /sdcard/InkStandby/standby.png"
            android:textSize="14sp" />

        <Button
            android:id="@+id/pickFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择图片文件（复制到 App 目录）" />

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://example.com/standby.png"
            android:inputType="textUri"
            android:textSize="14sp" />

        <Button
            android:id="@+id/testUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="测试下载并解码" />

        <EditText
            android:id="@+id/textTemplate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="支持变量：{date} {time} {weekday} {battery}"
            android:minLines="5"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/quotesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="每行一条语录，亮屏时随机选一条"
            android:minLines="5"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="文字排版"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="字号"
            android:textColor="#333333"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/fontGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbFontSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="小" />

            <RadioButton
                android:id="@+id/rbFontNormal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="中" />

            <RadioButton
                android:id="@+id/rbFontLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="大" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="对齐"
            android:textColor="#333333"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/alignGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbAlignCenter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="居中" />

            <RadioButton
                android:id="@+id/rbAlignLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="左对齐" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cbFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示底部时间/签名" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="图片模式"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="适配方式"
            android:textColor="#333333"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/fitGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbFit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="适应" />

            <RadioButton
                android:id="@+id/rbCrop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="裁剪" />

            <RadioButton
                android:id="@+id/rbStretch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="拉伸" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="背景色"
            android:textColor="#333333"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/bgGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbBgWhite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="白" />

            <RadioButton
                android:id="@+id/rbBgBlack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="黑" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cbSkip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="内容不变时跳过（减少墨水屏刷新）" />

        <Button
            android:id="@+id/applyNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="立即应用（强制刷新）" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存设置" />

        <TextView
            android:id="@+id/tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#555555"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
